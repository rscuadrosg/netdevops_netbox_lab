---
# yamllint settings for this repo, used locally and in CI.
# The rule overrides below are the ones ansible-lint requires to agree
# with yamllint.

extends: default

# Skip generated files (e.g. Containerlab's clab-*/ directory)
ignore-from-file: .gitignore

rules:
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
